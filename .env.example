# Configuration Keycloak SSO (YAHO / IAHO)
# ⚠️ Ne pas committer de valeurs réelles : uniquement des exemples.

# URL du serveur Keycloak (realm IAHO)
VITE_KEYCLOAK_URL=https://auth.tsirylab.com

# Realm Keycloak (IAHO selon la doc officielle docs.tsirylab.com)
VITE_KEYCLOAK_REALM=IAHO

# Client Keycloak SPA public (PKCE) — aucun client_secret côté frontend
VITE_KEYCLOAK_CLIENT_ID=iaho-frontend

# Redirect URI enregistré côté Keycloak (doit correspondre à la config réelle du client)
VITE_KEYCLOAK_REDIRECT_URI=http://localhost:3000/callback

# URL de base de l'API (gateway Service Auth)
VITE_API_BASE_URL=https://gateway.tsirylab.com
